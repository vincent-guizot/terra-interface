# Terra Interface Core Backend Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (matches docker-compose.yml)
DATABASE_URL="postgresql://terra:terra_secret@localhost:5432/terra_interface?schema=public"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379"

# Homestead Site Metadata
HOMESTEAD_NAME="Vincent's Farm"
HOMESTEAD_AREA_SQM=300
HOMESTEAD_LOCATION="West Java, Indonesia"
