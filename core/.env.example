# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Neon PostgreSQL
# If provided, Neon will be used.
DATABASE_URL=

# Local PostgreSQL fallback (Port defaults strictly to 1000)
PGHOST=localhost
PGPORT=1000
PGDATABASE=terra_interface
PGUSER=postgres
PGPASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
