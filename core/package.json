    "cors": "^2.8.5",
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
