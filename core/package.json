{
  "name": "terra-core",
  "version": "1.0.0",
  "description": "Terra Interface — Home OS Modular Backend Engine (Express)",
  "private": true,
  "scripts": {
    "build": "node -e \"console.log('Core is plain JavaScript; no build step required.')\"",
    "start": "node src/main.js",
    "start:dev": "node --watch src/main.js",
    "test": "node test/runner.js",
