{
  "name": "terra-core",
  "version": "1.0.0",
  "description": "Terra Interface — Home OS Modular Backend Engine (Express)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:invariants && npm run test:http",
    "db:test": "node scripts/test-db.js",
    "test:invariants": "node tests/invariants/runner.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seeders/seed.js",
    "prisma:studio": "prisma studio",
    "db:setup": "node scripts/init-db.js",
    "test:http": "node tests/runner.js && node --test tests/router-contract.test.js",
    "build": "node scripts/check-source.js",
    "start:dev": "node --watch src/server.js"
  },
  "prisma": {
    "seed": "node prisma/seeders/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.10.0"
  }
}
